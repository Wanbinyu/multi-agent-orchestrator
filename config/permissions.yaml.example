# Copy to config/permissions.yaml for user-wide rules, or to
# <project>/.mao/permissions.yaml for project-scoped rules.
#
# Note: MAO also hard-blocks sensitive paths (.env, *.pem, .ssh, …) and
# interpreter inline/preload code in tools. These rules are an extra policy
# layer (deny > ask > allow), not an OS sandbox.
rules:
  - action: deny
    tool: run_command
    pattern: "rm *"
    justification: "禁止递归或批量删除；请改用精确文件操作"
    match:
      - "rm -rf build"
    not_match:
      - "python -m pytest tests"
  - action: ask
    tool: run_command
    pattern: "npx *"
    justification: "npx 可下载并执行远程包；默认要求确认，优先改用已安装本地脚本"
  - action: ask
    tool: write_file
    pattern: "**/*.py"
    justification: "Python 源码修改需要确认"
  - action: allow
    tool: run_command
    pattern: "python -m pytest *"
    justification: "允许项目测试"
    match:
      - "python -m pytest tests"
    not_match:
      - "python -m pip install pytest"
